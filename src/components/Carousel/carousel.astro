---
import { getTranslations } from "../../i18n/translations";

const t = getTranslations(Astro.currentLocale || "es");
---

<script>
    import EmblaCarousel from 'embla-carousel'
    import AutoHeight from 'embla-carousel-auto-height'
    import AutoPlay from 'embla-carousel-autoplay'
    import { setupTweenOpacity } from './EmblaCarouselTweenOpacity'
    import { addPrevNextButtonClickHandlers } from './EmblaCarouselArrowButtons'
    import { setupLazyLoadImage } from './EmblaCarouselLazyLoad'
    import './embla.css'
    import { getPhotos } from "../../lib/pb/Photos";

    async function loadPhotos() {
        const emblaContainerDiv = document.getElementsByClassName("embla__container")[0] as HTMLDivElement
        if (!emblaContainerDiv) return
        
        const photos = await getPhotos()

        photos.forEach(p => {
            const imgElement = document.createElement("img")

            imgElement.className = "embla__slide__img embla__lazy-load__img"
            imgElement.dataset.src = p.img
            imgElement.addEventListener("dblclick", () => {
              window.open(imgElement.dataset.src, "_blank")?.focus()
            })
            
            const emblaSlide = document.createElement("div")
            emblaSlide.className = "embla__slide embla__lazy-load"
            const emblaSpinner = document.createElement("span")
            emblaSpinner.className = "embla__lazy-load__spinner"

            emblaSlide.appendChild(emblaSpinner)
            emblaSlide.appendChild(imgElement)

            emblaContainerDiv.appendChild(emblaSlide)
        })

        const OPTIONS = { loop: true }

        const emblaNode = document.querySelector('.embla') as HTMLElement
        const viewportNode = emblaNode?.querySelector('.embla__viewport') as HTMLElement
        const prevBtn = emblaNode?.querySelector('.embla__button--prev')
        const nextBtn = emblaNode?.querySelector('.embla__button--next')

        const emblaApi = EmblaCarousel(
          viewportNode,
          OPTIONS, 
          [AutoHeight(), AutoPlay()]
        )

        const loadImagesInView = setupLazyLoadImage(emblaApi)

        setupTweenOpacity(emblaApi)
        addPrevNextButtonClickHandlers(emblaApi, prevBtn, nextBtn)

        loadImagesInView(emblaApi)
        emblaApi.on('reInit', loadImagesInView).on('slidesInView', loadImagesInView)
    }

    loadPhotos()

    document.addEventListener("astro:after-swap", loadPhotos);
</script>


<section>
    <h3 
        class="pt-12 subtitle text-center mt-4 text-pretty text-4xl text-gray-200 underline"
    >
        {t.photos}
    </h3>
    <div class="embla text-white py-10">
        <div class="embla__viewport">

            <div class="embla__container"></div>
            <div class="embla__controls">
                <div class="embla__buttons">
                <button
                    class="embla__button embla__button--prev embla__button--disabled"
                    type="button"
                >
                    <svg class="embla__button__svg" viewBox="0 0 532 532">
                    <path
                        fill="currentColor"
                        d="M355.66 11.354c13.793-13.805 36.208-13.805 50.001 0 13.785 13.804 13.785 36.238 0 50.034L201.22 266l204.442 204.61c13.785 13.805 13.785 36.239 0 50.044-13.793 13.796-36.208 13.796-50.002 0a5994246.277 5994246.277 0 0 0-229.332-229.454 35.065 35.065 0 0 1-10.326-25.126c0-9.2 3.393-18.26 10.326-25.2C172.192 194.973 332.731 34.31 355.66 11.354Z"
                    ></path>
                    </svg></button
                ><button
                    class="embla__button embla__button--next embla__button--disabled"
                    type="button"
                >
                    <svg class="embla__button__svg" viewBox="0 0 532 532">
                    <path
                        fill="currentColor"
                        d="M176.34 520.646c-13.793 13.805-36.208 13.805-50.001 0-13.785-13.804-13.785-36.238 0-50.034L330.78 266 126.34 61.391c-13.785-13.805-13.785-36.239 0-50.044 13.793-13.796 36.208-13.796 50.002 0 22.928 22.947 206.395 206.507 229.332 229.454a35.065 35.065 0 0 1 10.326 25.126c0 9.2-3.393 18.26-10.326 25.2-45.865 45.901-206.404 206.564-229.332 229.52Z"
                    ></path>
                    </svg>
                </button>
                </div>
                <!-- <div class="embla__dots rounded border border-yellow-600"></div> -->
            </div>
        </div>
    </div>
</section>