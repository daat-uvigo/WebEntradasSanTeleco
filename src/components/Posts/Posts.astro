---
import { getTranslations } from "../../i18n/translations";

const t = getTranslations(Astro.currentLocale || "es");

---

<script>

  import { getPosts } from "../../lib/pb/Posts"
  
  async function loadPosts() {
    const partnersDiv = document.getElementById("posts") as HTMLDivElement
    
    const posts = await getPosts()
  
    posts.forEach(p => {
      const link = document.createElement("a")
      link.href = p.url
      
      const imgElement = document.createElement("img")
      imgElement.src = p.img

      link.appendChild(imgElement)
      partnersDiv.appendChild(link)
    })
  }

  loadPosts()

  document.addEventListener("astro:after-swap", loadPosts);
</script>

<section>
    <h3
        class="pt-12 subtitle text-center mt-4 text-pretty text-4xl text-gray-200 underline"
    >
        {t.info}
    </h3>
    <div
        id="posts"
        class="pt-6 *:rounded *:hover:shadow-lg *:hover:shadow-indigo-600 *:border *:border-gray-600 *:brightness-95 *:hover:brightness-100 "
    >
    </div>
</section>

<style>

    #posts {
        display: grid;
        grid-template-columns: repeat(1, 1fr);   
        
        @media (width >= 48rem) {
            grid-template-columns: repeat(3, 1fr);   
        }
        gap: 1rem;
        justify-content: center;
        align-items: center;
        justify-items: center;
    }

</style>