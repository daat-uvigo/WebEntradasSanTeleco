<script>

  import { getPosts } from "../../lib/pb/Posts"
  
  async function loadPosts() {
    const partnersDiv = document.getElementById("posts") as HTMLDivElement
    
    const posts = await getPosts()
  
    posts.forEach(p => {
      console.log(p)
      const link = document.createElement("a")
      link.href = p.url
      
      const imgElement = document.createElement("img")
      imgElement.src = p.img

      link.appendChild(imgElement)
      partnersDiv.appendChild(link)
    })
  }

  loadPosts()

  document.addEventListener("astro:after-swap", loadPosts);
</script>

<section>
    <h3
        class="pt-12 subtitle text-center mt-4 text-pretty text-4xl text-gray-200 underline"
    >
        Info
    </h3>
    <div
        id="posts"
        class="pt-6 *:rounded *:shadow-xl *:shadow-indigo-800"
    >
    </div>
</section>

