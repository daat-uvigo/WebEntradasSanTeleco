<script>

  import { getPartners } from "../../lib/pb/Partners"
  
  async function loadPartnersImages() {
    const partnersDiv = document.getElementById("partners") as HTMLDivElement
    
    const partners = await getPartners()
  
    partners.forEach(p => {
      const imgElement = document.createElement("img")
      imgElement.src = p.logo 
      partnersDiv.appendChild(imgElement)
    })
  }

  loadPartnersImages()

  document.addEventListener("astro:after-swap", loadPartnersImages);
</script>

<section>
    <h3
        class="pt-12 subtitle text-center mt-4 text-pretty text-4xl text-gray-200 underline"
    >
        Partners
    </h3>
    <div
        id="partners"
        class="pt-6 *:rounded *:shadow-xl *:shadow-indigo-800 *:ring-4 *:ring-indigo-800 *:p-0.5 *:bg-indigo-800"
    >
    </div>
</section>

<style>

    #partners {
        display: grid;
        grid-template-columns: repeat(2, 1fr);   
        
        @media (width >= 48rem) {
            grid-template-columns: repeat(3, 1fr);   
        }
        gap: 1rem;
        justify-content: center;
        align-items: center;
        justify-items: center;
    }

</style>