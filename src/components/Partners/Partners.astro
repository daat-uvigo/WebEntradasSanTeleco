---
import { getTranslations } from "../../i18n/translations";

const t = getTranslations(Astro.currentLocale || "es");
---

<script>

  import { getPartners } from "../../lib/pb/Partners"
  
  async function loadPartnersImages() {
    const partnersDiv = document.getElementById("partners") as HTMLDivElement
    const partnersStyles = window.getComputedStyle(partnersDiv)
    
    const partners = await getPartners()
  
    partners.forEach((p, i) => {
      const imgElement = document.createElement("img")
      imgElement.src = p.logo 
      partnersDiv.appendChild(imgElement)
      if (i === partners.length -1 && partners.length % 3 != 0) {
        if (partnersStyles.getPropertyValue("--mobile") == "0") {
          imgElement.style.gridColumn = "span 3"
        }
      }
    })
  }

  loadPartnersImages()

  document.addEventListener("astro:after-swap", loadPartnersImages);
</script>

<section>
    <h3
        class="pt-12 subtitle text-center mt-4 text-pretty text-4xl text-gray-200 underline"
    >
        {t.partners}
    </h3>
    <div
        id="partners"
        class="pt-6 *:rounded *:p-3 *:border *:border-gray-700 *:saturate-105 *:hover:bg-gray-800"
    >
    </div>
</section>

<style>

    #partners {
        --mobile: 1;
        display: grid;
        grid-template-columns: repeat(2, 1fr);   
        
        @media (width >= 48rem) {
            --mobile: 0;
            grid-template-columns: repeat(3, 1fr);
        }
        gap: 1rem;
        justify-content: center;
        align-items: center;
        justify-items: center;
    }

</style>