---

import { Image } from "astro:assets"
import "atropos/atropos.min.css"
import camisetaFrontal from "./camiseta-frontal.png"
import camisetaReverso from "./camiseta-reverso.png"

---

<script>

import Atropos from 'atropos';

function initAtropos() {
  // Initialize
  Atropos({
    el: '#camiseta-frontal',
    shadow: false,
    highlight: false
    // rest of parameters
  });

  Atropos({
    el: '#camiseta-reverso',
    shadow: false,
    highlight: false
    // rest of parameters
  });
}

initAtropos()

document.addEventListener("astro:after-swap", initAtropos);

</script>

<section class="flex flex-col md:flex-row md:gap-3 p-6">
    <div class="atropos mx-auto py-12 rounded-2xl" id="camiseta-frontal" data-height={camisetaFrontal.height} data-width={camisetaFrontal.width}>
      <!-- scale container (required) -->
      <div class="atropos-scale">
        <!-- rotate container (required) -->
        <div class="atropos-rotate">
          <!-- inner container (required) -->
          <div class="atropos-inner rounded-2xl mx-auto">
            <!-- put your custom content here -->
            <Image src={camisetaFrontal} alt="camiseta santeleco actual frontal" />            
          </div>
        </div>
      </div>
    </div>
    
    <div class="atropos camiseta mx-auto py-12 rounded-2xl" id="camiseta-reverso" data-height={camisetaReverso.height} data-width={camisetaReverso.width}>
      <!-- scale container (required) -->
      <div class="atropos-scale">
        <!-- rotate container (required) -->
        <div class="atropos-rotate">
          <!-- inner container (required) -->
          <div class="atropos-inner rounded-2xl mx-auto">
            <!-- put your custom content here -->
            <Image src={camisetaReverso} alt="camiseta santeleco actual reverso" />
            
          </div>
        </div>
      </div>
    </div>
</section>

<style>

@reference "tailwindcss"

.camiseta {
    @apply md:w-120;
    height: attr(data-height px)
}

</style>