---
import MainLayout from "../layouts/MainLayout.astro";
---

<script>
    import "altcha";
</script>

<MainLayout>
    <form
        action="/api/reserva"
        method="post"
        enctype="multipart/form-data"
        class="mx-auto max-w-md space-y-4 rounded-lg border p-6 border-gray-600 bg-gray-800"
    >

        <div>
            <label class="block text-sm font-medium text-white" for="full_name">
                Nombre completo*
            </label>

            <input
                name="full_name"
                class="mt-1 w-full p-3 rounded-lg focus:border-indigo-500 focus:outline-none border-gray-600 bg-gray-900 text-white"
                id="full_name"
                type="text"
                required
                placeholder="Nombre Apellido Apellido"
            />
        </div>

        <div>
            <label class="block text-sm font-medium text-white" for="email">
                Correo electrónico*
            </label>

            <input
                name="email"
                class="mt-1 w-full p-3 rounded-lg focus:border-indigo-500 focus:outline-none border-gray-600 bg-gray-900 text-white"
                id="email"
                type="email"
                required
                placeholder="ejemplo@gmail.com"
            />

        </div>

        <div class="flex flex-row gap-3">
            <label class="block text-sm font-medium text-white" for="email">
                He leído y acepto la
                <a href="/politica-de-privacidad" class="underline">Politica de privacidad</a>
            </label>

            <input type="checkbox" required>
        </div>
        
        <div class="hidden">
            <altcha-widget challengeurl="/api/challenge" language="es-es" auto="onsubmit" hidelogo hidefooter></altcha-widget>
        </div>
        
        <button
            class="block w-full rounded-lg border border-indigo-600 bg-indigo-600 px-12 py-3 text-sm font-medium text-white transition-colors hover:bg-indigo-700 hover:text-white"
            type="submit"
        >
            Pedir reserva
        </button>
    </form>
</MainLayout>
