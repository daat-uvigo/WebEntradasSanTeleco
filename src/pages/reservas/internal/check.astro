---
import MainLayout from "../../../layouts/MainLayout.astro"

---

<script>

import QrScanner from 'qr-scanner'; 
import type { reservasTable } from '../../../lib/db/schema';

const videoElement = document.getElementById("qr-video") as HTMLVideoElement
const reservasElement = document.getElementById("reservas") as HTMLDivElement
const resultElement = document.getElementById("result") as HTMLSpanElement

const scanBtn = document.getElementById("scan-btn") as HTMLButtonElement
const actionBtn = document.getElementById("buy-btn") as HTMLButtonElement

let currentUser: {id?: string; emailHash?: string, verified?: boolean} = {}

async function reloadReservas(result: string, scanner?: QrScanner) {
  try {
    
    actionBtn.classList.add("hidden")
    
    const {id , email_hash} = JSON.parse(result)
    
    const res = await fetch(`/reservas/api/internal/check?id=${encodeURI(id)}&email_hash=${encodeURI(email_hash)}`, {
      method: "GET"
    })
    
    if (!res.ok) {
      resultElement.innerText = "No hay reserva"
      return
    }
    
    const resData = await res.json() as {
       id: string;
       full_name: string;
       verified: boolean | null;
       emailHash: string;
    }      
    
    if (!resData.verified) {
      resultElement.innerText = `Reservada: ${resData.full_name} \n(${id})`
      currentUser.id = id
      currentUser.emailHash = email_hash
      currentUser.verified = false
      actionBtn.innerText = "Marcar como comprado"
      actionBtn.classList.remove("hidden")
    } else {
      currentUser.verified = true
      resultElement.innerText = `Comprada: ${resData.full_name} \n(${id})`
      actionBtn.innerText = "Desmarcar comprado"
      actionBtn.classList.remove("hidden")
    }
    
  } catch {
    resultElement.innerText = "Hubo un error en el proceso de verificación"
  } finally {
    scanner?.stop()
  }
}

async function scanQr() {
  
  const scanner = new QrScanner(
    videoElement,
    async result => {
      await reloadReservas(result.data, scanner)
    },
    {}
  )
  
  await scanner.start()
}

async function action() {
  try {
    const url = new URL(window.location.href);
    const query = new URLSearchParams(url.searchParams)
  
    const secret_key = query.get("secret_key")
    
    const { id, emailHash } = currentUser
    
    if (!currentUser.verified) {
      const res = await fetch(`/reservas/api/internal/check?id=${encodeURI(id!)}&email_hash=${encodeURI(emailHash!)}&secret_key=${secret_key}&action=BUY`, {
        method: "PATCH"
      })
    
      if (!res.ok) {
        throw new Error()
      }
  
      currentUser.verified = true
      resultElement.innerHTML = "Comprada con exito"
    } else {
      const res = await fetch(`/reservas/api/internal/check?id=${encodeURI(id!)}&email_hash=${encodeURI(emailHash!)}&secret_key=${secret_key}&action=UNDO-BUY`, {
        method: "PATCH"
      })
    
      if (!res.ok) {
        throw new Error()
      }
  
      currentUser.verified = false
      resultElement.innerHTML = "Desmarcar comprada con exito"
    }

    await reloadReservas(JSON.stringify(currentUser))
    
    
  } catch {

     if (!currentUser.verified) {
       resultElement.innerText = "Hubo un error en el proceso de compra"
     } else {
       resultElement.innerText = "Hubo un error en el proceso de desmarcar la compra"
     }
  }
}

async function getReservas() {
  try {
    const url = new URL(window.location.href);
    const query = new URLSearchParams(url.searchParams)
  
    const secret_key = query.get("secret_key")

    if (!secret_key) throw new Error()
    
    const res = await fetch(`/reservas/api/internal/reservas?secret_key=${secret_key}`, {
      method: "GET"
    })
  
    if (!res.ok) {
      throw new Error()
    }

    const reservas = await res.json() as typeof reservasTable[]
    reservas.forEach((r) => {
      const rElement = document.createElement("p")
      rElement.innerText = `Nombre: ${r.full_name} (ID: ${r.id}): Comprada - ${r.verified ? 'SI' : 'NO'}  `
      reservasElement.append(rElement)
    })
    
  } catch {
    reservasElement.innerText = "Hubo un error en el proceso de listar reservas"
  }
}

getReservas()

scanBtn.addEventListener("click", scanQr)
actionBtn.addEventListener("click", action)

</script>

<MainLayout>
    <div class="flex flex-col gap-4">

        <div id="reservas" class="text-white">
            
        </div>
        
        <h2 class="text-white text-xl">
            Resultado
        </h2>
        <span class="h-10 text-white" id="result"></span>
        
        <div class="flex flex-row">
            <button id="scan-btn" class="rounded-md bg-indigo-600 px-5 py-2.5 text-sm font-medium text-white shadow-sm dark:hover:bg-indigo-700">
                Escanear
            </button>
            <button id="buy-btn" class="hidden rounded-md bg-green-400 px-5 py-2.5 text-sm font-medium text-white shadow-sm dark:hover:bg-indigo-700">
                Marcar como comprado
            </button>
        </div>
        
        
        <video id="qr-video"></video>
    </div>
    
</MainLayout>