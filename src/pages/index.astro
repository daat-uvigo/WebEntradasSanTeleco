---
import MainLayout from "../layouts/MainLayout.astro"
---

<script>

  import { getPartners } from "../lib/pb/Partners"
  
  async function loadPartnersImages() {
    const partnersDiv = document.getElementById("partners") as HTMLDivElement
    
    const partners = await getPartners()
  
    partners.forEach(p => {
      const imgElement = document.createElement("img")
      imgElement.src = p.logo 
      partnersDiv.appendChild(imgElement)
    })
  }

  loadPartnersImages()

  document.addEventListener("astro:after-swap", loadPartnersImages);
</script>

<MainLayout>
        <section class="mx-auto max-w-prose text-center">
          <h1 class="title text-center font-bold text-8xl text-white">
              San Teleco
            <strong class="text-indigo-600"> 2026 </strong>
          </h1>
    
          <p class="subtitle text-center mt-4 text-pretty text-4xl text-gray-200">
              Ven a SanTeleco, la mítica fiesta universitaria
          </p>
    
          <div class="flex gap-4 mt-10 sm:mt-6 justify-center">
            <a class="inline-block rounded border border-indigo-600 bg-indigo-600 px-5 py-3 font-medium text-white shadow-sm transition-colors hover:bg-indigo-700" href="/reservar">
                Reservar
            </a>
    
            <a class="inline-block rounded border px-5 py-3 font-medium shadow-sm transition-colors 0 border-gray-700 text-gray-200 hover:bg-gray-800 hover:text-white" href="/faq">
                FAQ 
            </a>
          </div>
        </section>
        <section>
            <h3 class="pt-12 subtitle text-center mt-4 text-pretty text-4xl text-gray-200 underline">Partners</h3>
            <div id="partners" class="pt-6 *:rounded *:shadow-xl *:shadow-indigo-800 *:ring-4 *:ring-indigo-800 *:p-0.5 *:bg-indigo-800">
                
            </div>
        </section>

        <section>

          <div class="embla text-white">
            <div class="embla__viewport">
              <div class="embla__container">

                <div class="embla__slide embla__lazy-load">1
                  <span class="embla__lazy-load__spinner"></span>
                  <img
                    class="embla__slide__img embla__lazy-load__img"
                    data-src="http://127.0.0.1:8090/api/files/pbc_952735905/glnjlfu0st4y1et/images_882pq4hnbd.jpg?token="
                    alt="Your alt text"
                    src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs%3D"
                  />
                </div>

                <div class="embla__slide embla__lazy-load">2
                  <span class="embla__lazy-load__spinner"></span>
                  <img
                    class="embla__slide__img embla__lazy-load__img"
                    data-src="http://127.0.0.1:8090/api/files/pbc_952735905/glnjlfu0st4y1et/images_882pq4hnbd.jpg?token="
                    alt="Your alt text"
                    src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs%3D"
                  />
                </div>
                <div class="embla__slide embla__lazy-load">3
                  <span class="embla__lazy-load__spinner"></span>
                  <img
                    class="embla__slide__img embla__lazy-load__img"
                    data-src="http://127.0.0.1:8090/api/files/pbc_952735905/glnjlfu0st4y1et/images_882pq4hnbd.jpg?token="
                    alt="Your alt text"
                    src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs%3D"
                  />
                </div>
            </div>
            <div class="embla__controls">
              <div class="embla__buttons">
                <button
                  class="embla__button embla__button--prev embla__button--disabled"
                  type="button"
                >
                  <svg class="embla__button__svg" viewBox="0 0 532 532">
                    <path
                      fill="currentColor"
                      d="M355.66 11.354c13.793-13.805 36.208-13.805 50.001 0 13.785 13.804 13.785 36.238 0 50.034L201.22 266l204.442 204.61c13.785 13.805 13.785 36.239 0 50.044-13.793 13.796-36.208 13.796-50.002 0a5994246.277 5994246.277 0 0 0-229.332-229.454 35.065 35.065 0 0 1-10.326-25.126c0-9.2 3.393-18.26 10.326-25.2C172.192 194.973 332.731 34.31 355.66 11.354Z"
                    ></path>
                  </svg></button
                ><button
                  class="embla__button embla__button--next embla__button--disabled"
                  type="button"
                >
                  <svg class="embla__button__svg" viewBox="0 0 532 532">
                    <path
                      fill="currentColor"
                      d="M176.34 520.646c-13.793 13.805-36.208 13.805-50.001 0-13.785-13.804-13.785-36.238 0-50.034L330.78 266 126.34 61.391c-13.785-13.805-13.785-36.239 0-50.044 13.793-13.796 36.208-13.796 50.002 0 22.928 22.947 206.395 206.507 229.332 229.454a35.065 35.065 0 0 1 10.326 25.126c0 9.2-3.393 18.26-10.326 25.2-45.865 45.901-206.404 206.564-229.332 229.52Z"
                    ></path>
                  </svg>
                </button>
              </div>
              <div class="embla__dots rounded border border-yellow-600"></div>
            </div>
          </div>
        </section>
        <script src = ./index.js></script>
</MainLayout>

<style>

    #partners {
        display: grid;
        grid-template-columns: repeat(2, 1fr);   
        
        @media (width >= 48rem) {
            grid-template-columns: repeat(3, 1fr);   
        }
        gap: 1rem;
        justify-content: center;
        align-items: center;
        justify-items: center;
    }

</style>
